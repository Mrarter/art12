/* 黑金风格 - 艺术品详情页样式 */

/* ===== 全局 ===== */
.page {
  background: #0F0F10;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* ===== 导航栏 ===== */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 176rpx;
  padding: 88rpx 32rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  z-index: 100;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.nav-icon {
  width: 32rpx;
  height: 32rpx;
}

.nav-title {
  font-size: 28rpx;
  color: rgba(237, 237, 237, 0.8);
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* ===== 作品大图 ===== */
.hero {
  width: 100%;
  height: 1000rpx;
  position: relative;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(transparent, rgba(15, 15, 16, 0.95));
}

.hero-overlay {
  position: absolute;
  bottom: 40rpx;
  left: 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #EDEDED;
  display: block;
}

.hero-artist {
  font-size: 26rpx;
  color: rgba(237, 237, 237, 0.6);
  margin-top: 8rpx;
  display: block;
}

/* ===== 卡片 ===== */
.card {
  background: linear-gradient(135deg, #1A1A1C 0%, #1E1E20 100%);
  margin: 24rpx 32rpx;
  padding: 36rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.08);
}

/* ===== 信息卡片 ===== */
.info-card {
  position: relative;
  overflow: hidden;
}

.info-card::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.05), transparent 70%);
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: #EDEDED;
  display: block;
}

.meta {
  font-size: 24rpx;
  color: rgba(168, 168, 168, 0.8);
  margin-top: 12rpx;
  display: block;
}

/* ===== 价格区域 ===== */
.price-section {
  margin-top: 32rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid rgba(212, 175, 55, 0.1);
  border-bottom: 1rpx solid rgba(212, 175, 55, 0.1);
}

.label {
  font-size: 22rpx;
  color: rgba(237, 237, 237, 0.4);
  letter-spacing: 1rpx;
  display: block;
}

.price {
  font-size: 72rpx;
  color: #D4AF37;
  font-weight: 700;
  margin-top: 8rpx;
  display: block;
  letter-spacing: -2rpx;
  text-shadow: 0 0 60rpx rgba(212, 175, 55, 0.15);
}

/* ===== 统计行 ===== */
.stats-row {
  margin-top: 24rpx;
}

.growth {
  font-size: 24rpx;
  color: #C9A96E;
  display: block;
}

.count {
  font-size: 22rpx;
  color: rgba(237, 237, 237, 0.35);
  margin-top: 6rpx;
  display: block;
}

/* ===== 标签 ===== */
.tags {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
  flex-wrap: wrap;
}

.tag {
  border: 1rpx solid rgba(212, 175, 55, 0.35);
  color: #D4AF37;
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(212, 175, 55, 0.04);
}

/* ===== 流通记录 ===== */
.record-card {
  padding-bottom: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #EDEDED;
  display: block;
  margin-bottom: 28rpx;
}

.record-line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  position: relative;
}

.record-line::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 44rpx;
  bottom: 0;
  width: 1rpx;
  background: rgba(212, 175, 55, 0.15);
}

.record-line:last-child::before {
  display: none;
}

.record-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: rgba(237, 237, 237, 0.2);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-dot.gold {
  background: #D4AF37;
  box-shadow: 0 0 20rpx rgba(212, 175, 55, 0.4);
}

.record-price {
  font-size: 28rpx;
  color: #A8A8A8;
  font-weight: 500;
  flex: 1;
}

.record-price.gold {
  color: #D4AF37;
  font-weight: 700;
}

.record-date {
  font-size: 22rpx;
  color: rgba(237, 237, 237, 0.3);
}

.total-gain {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  font-size: 26rpx;
}

/* ===== 底部操作栏 ===== */
.bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: rgba(18, 18, 18, 0.98);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  padding: 0 32rpx 40rpx;
  gap: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
}

.action-btn {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.55;
}

.action-text {
  font-size: 20rpx;
  color: rgba(237, 237, 237, 0.4);
}

.buy-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #D4AF37 0%, #B8962E 50%, #8B1E1E 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(212, 175, 55, 0.25);
  position: relative;
  overflow: hidden;
}

.buy-btn::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255, 255, 255, 0.1) 50%,
    transparent 70%
  );
  animation: shimmer 3s ease-in-out infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%) rotate(45deg); }
  100% { transform: translateX(100%) rotate(45deg); }
}

.buy-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F0F10;
}

.buy-sub {
  font-size: 20rpx;
  color: rgba(15, 15, 16, 0.6);
  margin-top: 2rpx;
}
