# 拾艺局测试环境 Dockerfile（使用预构建 JAR）
# 构建: docker build -t shiyiju-test-backend -f Dockerfile.test .

FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# 复制预构建 JAR
COPY services/*.jar /app/

# 创建启动脚本
RUN echo '#!/bin/sh\n\
case $SERVICE in\n\
  gateway)   exec java -jar /app/shiyiju-gateway-1.0.0-SNAPSHOT.jar ;;\n\
  user)      exec java -jar /app/shiyiju-user-1.0.0-SNAPSHOT.jar ;;\n\
  product)   exec java -jar /app/shiyiju-product-1.0.0-SNAPSHOT.jar ;;\n\
  order)     exec java -jar /app/shiyiju-order-1.0.0-SNAPSHOT.jar ;;\n\
  auction)   exec java -jar /app/shiyiju-auction-1.0.0-SNAPSHOT.jar ;;\n\
  promotion) exec java -jar /app/shiyiju-promotion-1.0.0-SNAPSHOT.jar ;;\n\
  community) exec java -jar /app/shiyiju-community-1.0.0-SNAPSHOT.jar ;;\n\
  file)      exec java -jar /app/shiyiju-file-1.0.0-SNAPSHOT.jar ;;\n\
  message)   exec java -jar /app/shiyiju-message-1.0.0-SNAPSHOT.jar ;;\n\
  admin)     exec java -jar /app/shiyiju-admin-1.0.0-SNAPSHOT.jar ;;\n\
esac' > /start.sh && chmod +x /start.sh

CMD ["sh", "/start.sh"]
