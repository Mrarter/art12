# 通用前端环境变量示例
# 小程序一键登录依赖后端 WECHAT_APPID / WECHAT_SECRET
# 微信内 H5 一键登录依赖这里的公众号 AppID，以及后端 WECHAT_OFFICIAL_APPID / WECHAT_OFFICIAL_SECRET
# iOS/Android 原生微信登录依赖后端 WECHAT_OPEN_APPID / WECHAT_OPEN_SECRET

VITE_API_BASE_URL=https://your-domain.example/api
VITE_MP_GATEWAY_ORIGIN=https://your-domain.example
VITE_MP_FILE_ORIGIN=https://your-domain.example
VITE_IMAGE_BASE_URL=https://your-domain.example
VITE_WS_BASE_URL=wss://your-domain.example

# 微信公众号 AppID，用于 H5 跳转 open.weixin.qq.com
VITE_WECHAT_OFFICIAL_APP_ID=wx_your_official_appid
